<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Errgo</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Diego Rönkkömäki-Tapia</Authors>
    <Description>Errors-as-values in C#</Description>
    <PackageTags>errgo, error-handling, errors, error, result, result pattern, go, gostyle, csharp, dotnet, netstandard, no-exceptions</PackageTags>
    <PackageProjectUrl>https://github.com/TDMR87/Errgo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TDMR87/Errgo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageIcon>errgo_logo_sm.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

  </PropertyGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="\" />
    <None Include="..\img\errgo_logo_sm.png" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>