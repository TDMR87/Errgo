<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Errgo</PackageId>
    <Version>1.0.0</Version>
    <Authors>Your Name</Authors>
    <Description>Go-style error handling for C# with compile-time error checking</Description>
    <PackageTags>error-handling;go;errors;result</PackageTags>
    <PackageProjectUrl>https://github.com/TDMR87/Ergo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TDMR87/Ergo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- Include analyzers in package -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

</Project>
